# =============================================================================
# Rejestr zmian IT - konfiguracja środowiska
# =============================================================================
# Skopiuj do pliku .env (cp .env.example .env / Copy-Item .env.example .env)
# i uzupełnij hasła. Plik .env jest w .gitignore - NIGDY go nie commituj.
# Wartości poniżej to wyłącznie przykłady do lokalnego uruchomienia.
#
# Hasła: używaj znaków bezpiecznych w URL (litery, cyfry, - _ .). Inaczej
# trzeba je zakodować (percent-encoding) w DATABASE_URL i MIGRATIONS_DATABASE_URL.
# Wygenerowanie hasła (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
# =============================================================================

# --- Środowisko --------------------------------------------------------------

# Środowisko uruchomieniowe: "dev" (lokalnie) albo "prod" (produkcja).
# Gdy nieustawione, docker-compose przyjmuje "prod".
APP_ENV=prod

# Tryb uwierzytelniania (ADR 0018): "local" (konta lokalne z hasłem - tryb
# produkcyjny) albo "dev" (użytkownicy testowi z seeda, bez hasła). "dev" jest
# dozwolony WYŁĄCZNIE przy APP_ENV=dev - przy APP_ENV=prod API odmawia startu.
# Domyślnie "local".
AUTH_MODE=local
# Lokalnie (praca deweloperska) ustaw w .env: APP_ENV=dev i AUTH_MODE=dev.
# Pierwszego administratora w produkcji zakłada komenda (hasło z terminala,
# nigdy z argumentu): docker compose run --rm api python -m app.cli create-admin
#   --email admin@example.com --name "Imię Nazwisko"

# Klucz (HS256) podpisujący tokeny logowania deweloperskiego (AUTH_MODE=dev,
# endpointy /api/v1/auth/dev/*). WYMAGANY przy AUTH_MODE=dev, min. 32 znaki;
# przy AUTH_MODE=local nieużywany - zostaw pusty. Każde środowisko dev ma mieć
# własną, losową wartość (generowanie: patrz komenda na początku pliku).
# Zmiana klucza unieważnia wszystkie wydane tokeny dev.
DEV_AUTH_SECRET=

# --- Konta lokalne (AUTH_MODE=local, ADR 0018) ---------------------------------

# Klucz (HS256) podpisujący tokeny dostępu kont lokalnych. WYMAGANY przy
# AUTH_MODE=local - bez niego API odmawia startu. Losowy, min. 64 znaki przy
# APP_ENV=prod (min. 32 przy APP_ENV=dev). Generowanie (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 62 | % {[char]$_})
#   (dwukrotnie i skleić) albo: openssl rand -hex 48
# Zmiana klucza unieważnia wszystkie tokeny dostępu (sesje można odnowić
# tokenem odświeżania, bo ten nie jest podpisywany kluczem).
AUTH_JWT_SECRET=
# Czas życia tokenu dostępu w minutach (1-60). Sesja jest sprawdzana przy każdym
# żądaniu, więc wylogowanie, zmiana/reset hasła i dezaktywacja działają od razu.
# Domyślnie 15.
AUTH_ACCESS_TOKEN_MINUTES=15
# Token odświeżania wygasa, jeśli nie zostanie użyty przez tyle minut
# (bezczynność sesji). Domyślnie 120.
AUTH_REFRESH_IDLE_MINUTES=120
# Maksymalny czas trwania sesji od zalogowania (godziny); potem trzeba zalogować
# się ponownie. Domyślnie 12.
AUTH_SESSION_MAX_HOURS=12
# Blokada konta: tyle kolejnych błędnych haseł (3-100) blokuje konto na
# AUTH_LOCKOUT_MINUTES minut. Odblokowanie: upływ czasu albo reset hasła przez
# administratora. Domyślnie 5 prób i 15 minut.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
# Limit nieudanych logowań z jednej sieci klienta (IPv4 /32, IPv6 /64) w oknie
# AUTH_FAILURE_WINDOW_SECONDS - po jego przekroczeniu POST /auth/login zwraca 429
# (chroni przed zgadywaniem haseł wielu kont naraz, czego blokada pojedynczego
# konta nie widzi). Ogólny limit żądań to osobna warstwa (nginx). 0 = wyłączony.
# Domyślnie 30.
AUTH_LOGIN_MAX_FAILURES_PER_NETWORK=30
# Ważność hasła tymczasowego w godzinach (1-720): hasła nadanego przy zakładaniu
# konta (POST /users), resecie przez administratora i create-admin
# --generate-password. Po terminie logowanie nim jest odrzucane (401
# auth.temporary_password_expired), a sesja otwarta tym hasłem kończy się w chwili
# upływu terminu - potrzebny jest ponowny reset hasła przez administratora. Termin
# zapisuje się przy nadaniu hasła (zmiana wartości nie przesuwa terminów haseł już
# wydanych). ADR 0018 §12. Domyślnie 168 (7 dni).
TEMP_PASSWORD_TTL_HOURS=168

# Poziom logowania aplikacji: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Format logów api i workera (ADR 0019 §4): "json" - jeden obiekt JSON na linię
# (timestamp UTC, level, logger, message, request_id, user_id, company_id, path,
# status, duration_ms; hasła/tokeny/sekrety maskowane) - do produkcji i zbierania
# logów; "console" - czytelne linie do pracy lokalnej. Domyślnie "json".
LOG_FORMAT=json
# Limit czasu (s) sprawdzenia bazy w /api/v1/health; domyślnie 2.
DB_HEALTH_TIMEOUT_SECONDS=2

# Pule połączeń z bazą w KAŻDYM procesie api/worker (ADR 0010 §5).
# Pula główna - transakcje żądań. Maks. połączeń = POOL_SIZE + MAX_OVERFLOW.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Ile sekund żądanie czeka na wolne połączenie, zanim dostanie błąd 500.
DB_POOL_TIMEOUT_SECONDS=30
# Osobna, mała pula pomocnicza dla krótkich transakcji zdarzeń uwierzytelniania
# (logowanie, nieudane logowanie, odmowa dostępu, JIT). Musi być osobna: te
# transakcje bywają otwierane, gdy żądanie trzyma już połączenie z puli głównej,
# a wspólna pula prowadziłaby do wzajemnej blokady. Suma obu pul razy liczba
# procesów musi zmieścić się w max_connections PostgreSQL (domyślnie 100).
DB_AUX_POOL_SIZE=2
DB_AUX_MAX_OVERFLOW=3

# Agregacja nieudanych logowań w dzienniku audytu (ADR 0010). Próby są liczone
# w oknach czasowych per źródło (przyczyna + sieć klienta: IPv4 /32, IPv6 /64).
# Wpis w dzienniku powstaje od razu przy 1., 2., 4., 8., ... próbie w oknie,
# a po zamknięciu okna worker zapisuje dokładne podsumowanie - żadna próba nie
# znika z dziennika, ale zalew prób go nie zalewa.
# Długość okna w sekundach (10-86400). Domyślnie 300.
AUTH_FAILURE_WINDOW_SECONDS=300
# Maks. liczba różnych źródeł w jednym oknie; kolejne (np. rotacja adresów)
# są liczone razem w jednym kuble "overflow". Domyślnie 200.
AUTH_FAILURE_MAX_BUCKETS=200
# Maks. liczba wpisów natychmiastowych (1., 2., 4., ... próba) w jednym oknie,
# łącznie dla wszystkich źródeł. Powyżej limitu próby są tylko liczone i trafiają
# do podsumowania okna - nic nie ginie. Domyślnie 200.
AUTH_FAILURE_MAX_IMMEDIATE_ENTRIES=200

# Lista dozwolonych originów CORS (oddzielone przecinkami). Potrzebne tylko,
# gdy frontend działa pod innym adresem niż API (np. `flutter run -d chrome`).
# Przy pracy przez nginx (http://localhost:8080) API jest pod tym samym originem.
CORS_ORIGINS=http://localhost:8080,http://localhost:5000

# Adresy/podsieci (oddzielone przecinkami), którym API ufa w nagłówkach
# X-Forwarded-For / X-Forwarded-Proto - wyłącznie adres kontenera nginx (web),
# który w docker-compose.yml ma stały adres 172.28.0.10 w sieci 172.28.0.0/16.
# Nie wpisuj całej podsieci: ruch z hosta na port 127.0.0.1:8000 przychodzi
# z bramy 172.28.0.1 i mógłby podrobić IP. NIGDY "*": każdy klient mógłby
# podrobić adres IP zapisywany w dzienniku audytu. Przy uruchamianiu API poza
# Dockerem bez proxy zostaw domyślne uvicorna (127.0.0.1).
FORWARDED_ALLOW_IPS=172.28.0.10

# --- PostgreSQL --------------------------------------------------------------

# Hasło superużytkownika "postgres" w kontenerze db. Używane tylko do
# inicjalizacji bazy i administracji - aplikacja z niego nie korzysta.
POSTGRES_PASSWORD=zmien-mnie-postgres

# Hasło roli app_owner - właściciel schematu, używana WYŁĄCZNIE do migracji
# Alembic. Role tworzy skrypt deploy/postgres/init/10-roles.sh przy pierwszym
# starcie pustego wolumenu (zmiana hasła później wymaga ALTER ROLE).
APP_OWNER_PASSWORD=zmien-mnie-owner

# Hasło roli app_rw - rola, którą łączy się działająca aplikacja (api, worker).
# Nie jest właścicielem tabel; na audit_log ma tylko INSERT/SELECT.
APP_RW_PASSWORD=zmien-mnie-rw

# Połączenie aplikacji (api, worker) - rola app_rw. Hasło musi być zgodne
# z APP_RW_PASSWORD. Host "db" to nazwa usługi w docker-compose; przy
# uruchamianiu backendu poza Dockerem użyj localhost:5432.
DATABASE_URL=postgresql+asyncpg://app_rw:zmien-mnie-rw@db:5432/rejestr

# Połączenie dla migracji Alembic (usługa "migrate") - rola app_owner. Hasło
# musi być zgodne z APP_OWNER_PASSWORD.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://app_owner:zmien-mnie-owner@db:5432/rejestr

# --- Redis / worker ----------------------------------------------------------

# Adres Redisa (kolejka zadań arq - generowanie dużych raportów PDF w tle).
REDIS_URL=redis://redis:6379/0

# --- Pliki -------------------------------------------------------------------

# Katalog na załączniki i wygenerowane raporty wewnątrz kontenerów api/worker
# (wolumen "storage" w docker-compose). Lokalnie poza Dockerem np. ./storage.
STORAGE_PATH=/data/storage
# Maksymalny rozmiar jednego załącznika zmiany w bajtach (większe pliki API
# odrzuca kodem 413 attachment.too_large). Domyślnie 26214400 (25 MiB).
# Reverse proxy (nginx, NGINX_CLIENT_MAX_BODY_SIZE) musi przepuszczać co najmniej
# tyle plus kilka KB narzutu multipart.
ATTACHMENT_MAX_BYTES=26214400
# Dozwolone typy załączników (typy MIME oddzielone przecinkami). Typ jest
# rozpoznawany z ZAWARTOŚCI pliku (sygnatury, struktura ZIP dokumentów Office/ODF,
# tekst), a nie z nagłówka przeglądarki; inne typy API odrzuca kodem 415
# attachment.type_not_allowed. Puste = lista domyślna: PDF, PNG, JPEG, tekst
# (txt/log), CSV, JSON, XML, ZIP, DOCX, XLSX, ODT, ODS, MSG (Outlook), EML.
# Rozpoznawane, ale domyślnie WYŁĄCZONE: image/gif, image/webp, image/bmp,
# image/tiff, application/gzip, application/x-7z-compressed, PPTX
# (application/vnd.openxmlformats-officedocument.presentationml.presentation),
# ODP (application/vnd.oasis.opendocument.presentation), stare pliki Office
# (application/x-ole-storage), application/octet-stream (nierozpoznane pliki
# binarne). HTML (text/html), SVG (image/svg+xml) i programy
# (application/x-msdownload, application/x-executable) nie powinny być dozwolone.
# Nieznana wartość na liście = API odmawia startu.
ATTACHMENT_ALLOWED_TYPES=

# --- Raporty (PDF/CSV, ADR 0017) ----------------------------------------------

# Raport rejestru PDF obejmujący WIĘCEJ zmian niż ten próg jest generowany w tle
# przez worker (POST /api/v1/reports -> 202, status "pending"; frontend odpytuje
# GET /api/v1/reports/{id}). Mniejsze raporty i karty zmian - od razu (201).
# Wymaga działającego workera i Redisa. Domyślnie 200 (CLAUDE.md §9).
REPORT_ASYNC_THRESHOLD=200
# Maksymalna liczba zmian w jednym raporcie rejestru lub eksporcie CSV; większe
# API odrzuca kodem 422 report.too_large (zawęź okres lub filtry). Domyślnie 5000.
REPORT_MAX_CHANGES=5000

# --- Dziennik audytu -----------------------------------------------------------

# Znacznik "Łańcuch spójny" na karcie zmiany (GET /api/v1/companies/{id}/audit/status)
# opiera się na ostatniej zapisanej weryfikacji łańcucha spółki. Gdy jest starsza niż
# tyle godzin, API zwraca "stale" (brak twierdzenia o spójności). Worker weryfikuje
# wszystkie łańcuchy raz na dobę (02:30 UTC). Domyślnie 26.
AUDIT_STATUS_MAX_AGE_HOURS=26

# --- nginx (usługa "web"): limity żądań, nagłówki, TLS (ADR 0019) -------------

# Limity żądań per adres IP klienta (nginx limit_req; po przekroczeniu odpowiedź
# 429 application/problem+json z kodem request.rate_limited). Użytkownicy za
# jednym NAT-em (wspólne IP biura) dzielą limit - dobierz wartości do liczby osób.
# Szybkość: "<liczba>r/s" (na sekundę) albo "<liczba>r/m" (na minutę); BURST =
# ile żądań ponad szybkość jest przyjmowanych od razu (seria).
# Całe API (/api/): domyślnie 20r/s, seria 100.
NGINX_API_RATE=20r/s
NGINX_API_BURST=100
# Logowanie i zmiana hasła (/api/v1/auth/login, /auth/password, /auth/dev/token) -
# ochrona przed zgadywaniem haseł: domyślnie 10r/m, seria 10.
NGINX_AUTH_RATE=10r/m
NGINX_AUTH_BURST=10
# Odświeżanie tokenu (/api/v1/auth/refresh): domyślnie 30r/m, seria 20.
NGINX_REFRESH_RATE=30r/m
NGINX_REFRESH_BURST=20
# Maks. liczba jednoczesnych połączeń z jednego IP (limit_conn). Domyślnie 50.
NGINX_CONN_PER_IP=50
# Wartość nagłówka Retry-After (s) w odpowiedzi 429. Domyślnie 10.
NGINX_RETRY_AFTER=10
# Maks. rozmiar ciała żądania (nginx client_max_body_size, np. 26m). Musi być
# większy niż ATTACHMENT_MAX_BYTES (narzut multipart); większe żądania nginx
# odrzuca kodem 413 attachment.too_large. Domyślnie 26m (dla 25 MiB).
NGINX_CLIENT_MAX_BODY_SIZE=26m
# Nagłówek Strict-Transport-Security (HSTS). Ustaw TYLKO, gdy aplikacja jest
# dostępna wyłącznie przez HTTPS (TLS kończony na proxy przed nginx), np.
# "max-age=31536000; includeSubDomains". Puste = nagłówek nie jest wysyłany
# (HTTP lokalnie). Uwaga: przeglądarki zapamiętują HSTS na max-age.
NGINX_HSTS=
# Adres(y)/podsieci zaufanego proxy TLS PRZED nginx (np. 10.0.0.5 albo
# 10.0.0.0/24; jedna wartość). Od niego nginx przyjmuje X-Forwarded-For jako IP
# klienta (moduł realip) - dla limitów i dziennika audytu. Domyślnie
# 127.0.0.1/32 = brak zaufanego proxy. NIGDY 0.0.0.0/0.
NGINX_TRUSTED_PROXIES=127.0.0.1/32

# --- Kopie zapasowe (ADR 0019 §6, docs/deployment.md) --------------------------

# Ile dni trzymać kopie (scripts/backup.sh|ps1 i usługa "backup"); starsze pliki
# rejestr-* w katalogu kopii są usuwane. 0 = bez usuwania. Domyślnie 14.
BACKUP_RETENTION_DAYS=14
# Godzina (HH:MM, UTC) codziennej kopii wykonywanej przez usługę "backup"
# (docker compose --profile backup up -d backup). Domyślnie 01:30 - przed
# weryfikacją łańcuchów audytu przez worker (02:30 UTC).
BACKUP_AT=01:30
# Katalog na hoście, do którego usługa "backup" zapisuje kopie. Domyślnie
# ./backups (w .gitignore). W produkcji: osobny dysk / zasób kopiowany poza serwer.
BACKUP_HOST_DIR=./backups
# Monitoring kopii (ADR 0019 §11): usługa "backup" ma status "unhealthy"
# (docker compose ps), gdy ostatnia udana kopia jest starsza niż tyle godzin
# albo ostatnie zaplanowane uruchomienie się nie udało. Domyślnie 26 (kopia
# codzienna + zapas). Liczba całkowita godzin.
BACKUP_MAX_AGE_HOURS=26
# Szyfrowanie kopii programem age (ADR 0019 §10, docs/deployment.md §10).
# Klucz PUBLICZNY odbiorcy (age1..., z age-keygen); kilka kluczy rozdziel
# przecinkami (np. klucz zespołu + klucz awaryjny w sejfie). Ustawiony =
# usługa "backup" zapisuje tylko *.dump.age i *-storage.tar.gz.age (szyfrowane
# strumieniowo); pusty = kopie bez szyfrowania. Klucz publiczny nie jest
# sekretem. KLUCZA PRYWATNEGO (BACKUP_AGE_IDENTITY) NIE wpisuj tutaj i nie
# trzymaj na serwerze - potrzebny jest tylko przy odtwarzaniu.
# Skrypty scripts/backup.sh|ps1 NIE czytają .env: dla nich ustaw tę zmienną
# (albo BACKUP_AGE_RECIPIENTS = plik z kluczami publicznymi, age -R - tylko
# skrypty, nie usługa) w środowisku powłoki / zadania cron.
BACKUP_AGE_RECIPIENT=

# --- Porty i build (opcjonalne) ----------------------------------------------

# Port na hoście dla interfejsu webowego (nginx). Domyślnie 8080.
WEB_PORT=8080
# Port na hoście dla API (bezpośredni dostęp, np. /api/v1/docs - dokumentacja
# tylko przy APP_ENV=dev) - wystawiony tylko
# na 127.0.0.1; z innych maszyn API jest dostępne przez nginx. Domyślnie 8000.
API_PORT=8000
# Port PostgreSQL wystawiony tylko na 127.0.0.1 (do pracy poza Dockerem).
DB_PORT=5432
# Port Redisa wystawiony tylko na 127.0.0.1 (do pracy poza Dockerem).
REDIS_PORT=6379
# Origin API wkompilowany we frontend (dart-define API_URL) przy budowaniu
# obrazu "web" — BEZ sufiksu /api (klient sam dokleja /api/v1).
# Puste = ten sam origin (ruch przez nginx). Przy pracy lokalnej: http://localhost:8000
# Ta sama wartość trafia do Content-Security-Policy (connect-src) nginx.
WEB_API_URL=
