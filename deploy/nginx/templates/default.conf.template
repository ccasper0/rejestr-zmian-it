# nginx: serves the Flutter web build and reverse-proxies /api/ to the FastAPI
# container (ADR 0004, ADR 0019).
#
# This is a TEMPLATE: the official nginx image renders /etc/nginx/templates/*.template
# with envsubst into /etc/nginx/conf.d/ at container start. Only variables matching
# NGINX_ENVSUBST_FILTER (^NGINX_) are substituted - nginx's own $variables stay as is.
# Defaults of every NGINX_* variable: frontend/Dockerfile (ENV) and docker-compose.yml;
# descriptions: .env.example.

# Docker embedded DNS - resolve `api` lazily so nginx starts (and serves the
# SPA) even when the api container is not up yet or gets recreated.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# nginx's $request_id (32 hex chars) in the canonical UUID form used by the API, the
# audit log (audit_log.request_id) and the X-Request-ID response header.
map $request_id $request_uuid {
    "~^(?<p1>[0-9a-f]{8})(?<p2>[0-9a-f]{4})(?<p3>[0-9a-f]{4})(?<p4>[0-9a-f]{4})(?<p5>[0-9a-f]{12})$" "$p1-$p2-$p3-$p4-$p5";
    default $request_id;
}

# --- real client IP behind an optional TLS proxy (ADR 0019 §5) -----------------
# When a TLS-terminating reverse proxy stands in front of this container, list its
# address(es) in NGINX_TRUSTED_PROXIES: its X-Forwarded-For then replaces
# $remote_addr (used for rate limiting and passed to the API / audit log). Default
# 127.0.0.1/32 = nobody (the only local client is the healthcheck).
set_real_ip_from ${NGINX_TRUSTED_PROXIES};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# --- scheme seen by the client: X-Forwarded-Proto only from a trusted proxy -------
# $realip_remote_addr = the TCP peer BEFORE realip replaced $remote_addr, i.e. the
# proxy itself (or a direct client). Only when that peer is in NGINX_TRUSTED_PROXIES
# is its X-Forwarded-Proto ("https" or "http", map strings are case-insensitive;
# anything else, e.g. "https, http", is ignored) taken over; anybody else -
# also a direct client sending "X-Forwarded-Proto: https" - gets $scheme (this
# server listens on plain HTTP only). The result goes to the API (uvicorn
# --proxy-headers -> request.url.scheme) and decides about HSTS below.
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${NGINX_TRUSTED_PROXIES} 1;
}

map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    "1:https" https;
    "1:http"  http;
    default   $scheme;
}

# HSTS (RFC 6797 §7.2) only on responses delivered over HTTPS: NGINX_HSTS for
# $forwarded_proto = https, otherwise empty = add_header sends nothing. Behind a TLS
# proxy this requires NGINX_TRUSTED_PROXIES and "X-Forwarded-Proto: https" from it.
map $forwarded_proto $hsts_header {
    https   "${NGINX_HSTS}";
    default "";
}

# --- rate limiting (ADR 0019 §1) ---------------------------------------------------
# Keyed by client IP. Users behind one NAT share the limits - size them accordingly.
limit_req_zone $binary_remote_addr zone=api:10m rate=${NGINX_API_RATE};
limit_req_zone $binary_remote_addr zone=auth:10m rate=${NGINX_AUTH_RATE};
limit_req_zone $binary_remote_addr zone=refresh:10m rate=${NGINX_REFRESH_RATE};
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_req_status 429;
limit_conn_status 429;
limit_req_log_level warn;
limit_conn_log_level warn;

# --- access log: one JSON object per line, request_id = X-Request-ID = audit_log ---
log_format json_access escape=json
    '{"timestamp":"$time_iso8601","level":"info","logger":"nginx.access",'
    '"request_id":"$request_uuid","client_ip":"$remote_addr","method":"$request_method",'
    '"path":"$uri","status":$status,"bytes":$body_bytes_sent,'
    '"duration_s":$request_time,"upstream_s":"$upstream_response_time",'
    '"user_agent":"$http_user_agent"}';

server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;
    charset_types text/plain text/css application/javascript application/json application/problem+json application/manifest+json;

    # Query strings are NOT logged ($uri, not $request_uri): they may carry search
    # terms or identifiers; tokens never travel in URLs.
    access_log /var/log/nginx/access.log json_access;

    # Attachments are uploaded through /api/. Must be ATTACHMENT_MAX_BYTES plus the
    # multipart envelope (a few KB); the API enforces the exact limit (413
    # attachment.too_large). 26m covers the default 25 MiB.
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    limit_conn perip ${NGINX_CONN_PER_IP};

    # Errors produced by nginx itself (not by the API) in the API error format.
    error_page 429 @rate_limited;
    error_page 413 @too_large;

    # --- compression -------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/problem+json
        application/manifest+json
        application/wasm
        image/svg+xml
        font/ttf
        font/otf;

    # --- liveness of the web container itself ---------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- API reverse proxy ---------------------------------------------------
    # Credentials endpoints: much stricter limits (password guessing).
    location ~ ^/api/v1/auth/(login|password|dev/token)$ {
        limit_req zone=auth burst=${NGINX_AUTH_BURST} nodelay;
        include /etc/nginx/conf.d/snippets/api-proxy.inc;
    }

    location = /api/v1/auth/refresh {
        limit_req zone=refresh burst=${NGINX_REFRESH_BURST} nodelay;
        include /etc/nginx/conf.d/snippets/api-proxy.inc;
    }

    location /api/ {
        limit_req zone=api burst=${NGINX_API_BURST} nodelay;
        include /etc/nginx/conf.d/snippets/api-proxy.inc;
    }

    # --- nginx-generated errors as RFC 9457 problem+json -----------------------
    location @rate_limited {
        default_type application/problem+json;
        include /etc/nginx/conf.d/snippets/security-headers.inc;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Request-ID $request_uuid always;
        add_header Retry-After "${NGINX_RETRY_AFTER}" always;
        return 429 '{"type":"urn:rejestr:problem:request.rate_limited","title":"Zbyt wiele żądań","status":429,"code":"request.rate_limited","detail":"Przekroczono limit żądań. Odczekaj chwilę i spróbuj ponownie.","request_id":"$request_uuid"}';
    }

    location @too_large {
        default_type application/problem+json;
        include /etc/nginx/conf.d/snippets/security-headers.inc;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Request-ID $request_uuid always;
        return 413 '{"type":"urn:rejestr:problem:attachment.too_large","title":"Zbyt duże żądanie","status":413,"code":"attachment.too_large","detail":"Przesłany plik jest zbyt duży.","request_id":"$request_uuid"}';
    }

    location @api_unavailable {
        default_type application/problem+json;
        include /etc/nginx/conf.d/snippets/security-headers.inc;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header X-Request-ID $request_uuid always;
        return 503 '{"type":"urn:rejestr:problem:api.unavailable","title":"Usługa niedostępna","status":503,"code":"api.unavailable","detail":"Serwer aplikacji jest chwilowo niedostępny. Spróbuj ponownie za chwilę.","request_id":"$request_uuid"}';
    }

    # --- Flutter entry points: always revalidate (no content hashes) ----------
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter\.js|flutter_service_worker\.js|main\.dart\.(js|wasm|mjs)|version\.json|manifest\.json)$ {
        include /etc/nginx/conf.d/snippets/security-headers.inc;
        include /etc/nginx/conf.d/snippets/csp-web.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # --- SPA: go_router paths (/c/ALFA/changes/...) fall back to index.html ---
    location / {
        include /etc/nginx/conf.d/snippets/security-headers.inc;
        include /etc/nginx/conf.d/snippets/csp-web.inc;
        try_files $uri $uri/ /index.html;
    }
}
